Option Explicit

' Importiert den technischen Anhang eines freigegebenen Copilot-Word-Exports
' in die bestehende Backlog-Tabelle. Gesamtprioritaet und Quick-Win werden
' bewusst nicht geschrieben: Diese Werte berechnet die Arbeitsmappe selbst.

Private Const EXPECTED_SCHEMA As String = "2.0"
Private Const BACKLOG_SHEET As String = "Backlog"
Private Const PREFERRED_TABLE As String = "Tabelle14"
Private Const FILE_PICKER As Long = 3
Private Const IMPORT_TITLE As String = "Use-Case-Import"

Public Sub ImportUseCaseFromWord()
    Dim filePath As String
    Dim coreIds() As String, coreValues() As String
    Dim estimateIds() As String, estimateStatus() As String
    Dim estimateSource() As String, estimateConfidence() As String
    Dim estimateVerifyBy() As String
    Dim ws As Worksheet, backlog As ListObject
    Dim targetRow As ListRow, targetIndex As Long
    Dim rowBackup As Variant
    Dim rowWasAdded As Boolean, rowWasChanged As Boolean
    Dim applicationStateChanged As Boolean
    Dim previousCalculation As XlCalculation
    Dim ideaTitle As String
    Dim failureReason As String

    On Error GoTo ImportError

    filePath = PickWordFile()
    If Len(filePath) = 0 Then Exit Sub

    ReadAndValidateWordExport filePath, coreIds, coreValues, _
        estimateIds, estimateStatus, estimateSource, estimateConfidence, estimateVerifyBy

    ideaTitle = FieldValue(coreIds, coreValues, "idea_title")
    Set ws = ThisWorkbook.Worksheets(BACKLOG_SHEET)
    Set backlog = FindBacklogTable(ws)

    ValidateWorkbookStructure backlog
    If ProjectAlreadyExists(backlog, ideaTitle) Then
        If MsgBox("Ein Projekt mit dem Titel '" & ideaTitle & "' ist bereits vorhanden." & vbCrLf & _
                  "Soll trotzdem ein weiterer Eintrag angelegt werden?", _
                  vbQuestion + vbYesNo + vbDefaultButton2, IMPORT_TITLE) <> vbYes Then
            Exit Sub
        End If
    End If

    Set targetRow = FindOrCreateEmptyRow(backlog, rowWasAdded)
    targetIndex = targetRow.Index
    rowBackup = targetRow.Range.Formula

    previousCalculation = Application.Calculation
    Application.ScreenUpdating = False
    Application.EnableEvents = False
    Application.Calculation = xlCalculationManual
    applicationStateChanged = True

    rowWasChanged = True
    WriteMappedData backlog, targetIndex, filePath, _
        coreIds, coreValues, estimateIds, estimateStatus, estimateSource, estimateConfidence, estimateVerifyBy

    Application.Calculation = previousCalculation
    Application.Calculate
    Application.EnableEvents = True
    Application.ScreenUpdating = True

    MsgBox "Der Use Case '" & ideaTitle & "' wurde in die erste freie Backlog-Zeile importiert." & vbCrLf & vbCrLf & _
           "Nutzen, Aufwand und Dringlichkeit wurden als Eingabewerte uebernommen. " & _
           "Gesamtprioritaet und Quick-Win bleiben Formeln der Arbeitsmappe." & vbCrLf & vbCrLf & _
           "Bitte pruefe den neuen Eintrag und speichere die Arbeitsmappe anschliessend.", _
           vbInformation, IMPORT_TITLE
    Exit Sub

ImportError:
    failureReason = Err.Description
    On Error Resume Next
    If rowWasChanged Then
        If rowWasAdded Then
            targetRow.Delete
        Else
            targetRow.Range.Formula = rowBackup
        End If
    ElseIf rowWasAdded Then
        targetRow.Delete
    End If
    If applicationStateChanged Then
        Application.Calculation = previousCalculation
        Application.EnableEvents = True
        Application.ScreenUpdating = True
    End If
    On Error GoTo 0

    MsgBox "Der Import wurde abgebrochen. Es wurde kein unvollstaendiger Backlog-Eintrag behalten." & _
           vbCrLf & vbCrLf & "Grund: " & failureReason, vbCritical, IMPORT_TITLE
End Sub

Private Function PickWordFile() As String
    Dim selectedFile As Variant

    selectedFile = Application.GetOpenFilename( _
        Title:="Copilot-Word-Export fuer den Backlog-Import auswaehlen", _
        MultiSelect:=False)
    If VarType(selectedFile) = vbBoolean Then Exit Function
    If LCase$(Right$(CStr(selectedFile), 5)) <> ".docx" Then
        Err.Raise vbObjectError + 99, IMPORT_TITLE, "Bitte eine Word-Datei im Format .docx auswaehlen."
    End If
    PickWordFile = CStr(selectedFile)
End Function

Private Sub ReadAndValidateWordExport(ByVal filePath As String, _
    ByRef coreIds() As String, ByRef coreValues() As String, _
    ByRef estimateIds() As String, ByRef estimateStatus() As String, _
    ByRef estimateSource() As String, ByRef estimateConfidence() As String, _
    ByRef estimateVerifyBy() As String)

    Dim wordApp As Object, wordDocument As Object, tableItem As Object
    Dim coreTable As Object, estimateTable As Object
    Dim documentText As String
    Dim stageName As String

    On Error GoTo WordError

    stageName = "Mit geoeffnetem Microsoft Word verbinden"
    On Error Resume Next
    Set wordApp = GetObject(, "Word.Application")
    On Error GoTo WordError
    If wordApp Is Nothing Then
        Err.Raise vbObjectError + 98, IMPORT_TITLE, _
            "Microsoft Word ist nicht geoeffnet. Bitte Word einmal starten und den Import danach erneut ausfuehren."
    End If
    stageName = "Word-Dokument oeffnen"
    Set wordDocument = wordApp.Documents.Open(filePath, False, True, False)
    stageName = "Dokumenttext lesen"
    documentText = wordDocument.Content.Text

    If InStr(1, documentText, "BEGIN_TRANSFER_CORE_V2", vbTextCompare) = 0 Or _
       InStr(1, documentText, "END_TRANSFER_CORE_V2", vbTextCompare) = 0 Or _
       InStr(1, documentText, "BEGIN_ESTIMATE_REGISTER_V2", vbTextCompare) = 0 Or _
       InStr(1, documentText, "END_ESTIMATE_REGISTER_V2", vbTextCompare) = 0 Then
        Err.Raise vbObjectError + 100, IMPORT_TITLE, _
            "Eine technische Start- oder Endmarkierung fehlt. Bitte den Export-Prompt erneut ausfuehren."
    End If

    stageName = "Technische Tabellen suchen"
    For Each tableItem In wordDocument.Tables
        If IsCoreTable(tableItem) Then Set coreTable = tableItem
        If IsEstimateTable(tableItem) Then Set estimateTable = tableItem
    Next tableItem

    If coreTable Is Nothing Then
        Err.Raise vbObjectError + 101, IMPORT_TITLE, _
            "Die technische Kerntabelle FIELD_ID/VALUE wurde nicht gefunden."
    End If
    If estimateTable Is Nothing Then
        Err.Raise vbObjectError + 102, IMPORT_TITLE, _
            "Die technische Schaetzungstabelle wurde nicht gefunden."
    End If
    If coreTable.Rows.Count <> 69 Then
        Err.Raise vbObjectError + 103, IMPORT_TITLE, _
            "Die Kerntabelle hat " & coreTable.Rows.Count & " statt 69 Zeilen."
    End If
    If estimateTable.Rows.Count <> 18 Then
        Err.Raise vbObjectError + 104, IMPORT_TITLE, _
            "Die Schaetzungstabelle hat " & estimateTable.Rows.Count & " statt 18 Zeilen."
    End If

    stageName = "Kerntabelle lesen"
    ReadCoreTable coreTable, coreIds, coreValues
    stageName = "Schaetzungstabelle lesen"
    ReadEstimateTable estimateTable, estimateIds, estimateStatus, estimateSource, estimateConfidence, estimateVerifyBy

    stageName = "Kerndaten pruefen"
    ValidateCoreData coreIds, coreValues
    stageName = "Schaetzungsnachweise pruefen"
    ValidateEstimateData coreIds, coreValues, estimateIds, estimateStatus, estimateSource, estimateConfidence, estimateVerifyBy

    stageName = "Word-Dokument schliessen"
    wordDocument.Close False
    Exit Sub

WordError:
    Dim errorText As String
    errorText = stageName & ": " & Err.Description
    On Error Resume Next
    If Not wordDocument Is Nothing Then wordDocument.Close False
    On Error GoTo 0
    Err.Raise vbObjectError + 105, IMPORT_TITLE, errorText
End Sub

Private Function IsCoreTable(ByVal tableItem As Object) As Boolean
    On Error GoTo NotMatching
    If tableItem.Columns.Count <> 2 Then Exit Function
    IsCoreTable = (UCase$(CleanWordCell(tableItem.Cell(1, 1).Range.Text)) = "FIELD_ID" And _
                   UCase$(CleanWordCell(tableItem.Cell(1, 2).Range.Text)) = "VALUE")
    Exit Function
NotMatching:
    IsCoreTable = False
End Function

Private Function IsEstimateTable(ByVal tableItem As Object) As Boolean
    On Error GoTo NotMatching
    If tableItem.Columns.Count <> 5 Then Exit Function
    IsEstimateTable = (UCase$(CleanWordCell(tableItem.Cell(1, 1).Range.Text)) = "ESTIMATE_ID" And _
                       UCase$(CleanWordCell(tableItem.Cell(1, 2).Range.Text)) = "STATUS" And _
                       UCase$(CleanWordCell(tableItem.Cell(1, 3).Range.Text)) = "SOURCE" And _
                       UCase$(CleanWordCell(tableItem.Cell(1, 4).Range.Text)) = "CONFIDENCE" And _
                       UCase$(CleanWordCell(tableItem.Cell(1, 5).Range.Text)) = "VERIFY_BY")
    Exit Function
NotMatching:
    IsEstimateTable = False
End Function

Private Sub ReadCoreTable(ByVal tableItem As Object, ByRef ids() As String, ByRef values() As String)
    Dim rowNumber As Long, targetIndex As Long

    ReDim ids(1 To tableItem.Rows.Count - 1)
    ReDim values(1 To tableItem.Rows.Count - 1)
    For rowNumber = 2 To tableItem.Rows.Count
        targetIndex = rowNumber - 1
        ids(targetIndex) = LCase$(CleanWordCell(tableItem.Cell(rowNumber, 1).Range.Text))
        values(targetIndex) = CleanWordCell(tableItem.Cell(rowNumber, 2).Range.Text)
    Next rowNumber
End Sub

Private Sub ReadEstimateTable(ByVal tableItem As Object, _
    ByRef ids() As String, ByRef statusValues() As String, ByRef sourceValues() As String, _
    ByRef confidenceValues() As String, ByRef verifyByValues() As String)

    Dim rowNumber As Long, targetIndex As Long

    ReDim ids(1 To tableItem.Rows.Count - 1)
    ReDim statusValues(1 To tableItem.Rows.Count - 1)
    ReDim sourceValues(1 To tableItem.Rows.Count - 1)
    ReDim confidenceValues(1 To tableItem.Rows.Count - 1)
    ReDim verifyByValues(1 To tableItem.Rows.Count - 1)

    For rowNumber = 2 To tableItem.Rows.Count
        targetIndex = rowNumber - 1
        ids(targetIndex) = LCase$(CleanWordCell(tableItem.Cell(rowNumber, 1).Range.Text))
        statusValues(targetIndex) = LCase$(CleanWordCell(tableItem.Cell(rowNumber, 2).Range.Text))
        sourceValues(targetIndex) = CleanWordCell(tableItem.Cell(rowNumber, 3).Range.Text)
        confidenceValues(targetIndex) = LCase$(CleanWordCell(tableItem.Cell(rowNumber, 4).Range.Text))
        verifyByValues(targetIndex) = LCase$(CleanWordCell(tableItem.Cell(rowNumber, 5).Range.Text))
    Next rowNumber
End Sub

Private Function CleanWordCell(ByVal rawValue As String) As String
    rawValue = Replace(rawValue, Chr$(13), "")
    rawValue = Replace(rawValue, Chr$(7), "")
    rawValue = Replace(rawValue, ChrW$(160), " ")
    CleanWordCell = Trim$(rawValue)
End Function

Private Sub ValidateCoreData(ByRef ids() As String, ByRef values() As String)
    Dim expected As Variant, item As Variant, indexValue As Long
    Dim numericIds As Variant
    Dim scoreValue As Double, casesValue As Double, savingValue As Double, annualHours As Double
    Dim currentMinutes As Double

    expected = ExpectedCoreIds()
    ValidateExactIdentifierSet ids, expected, "Kerntabelle"

    If FieldValue(ids, values, "schema_version") <> EXPECTED_SCHEMA Then
        Err.Raise vbObjectError + 110, IMPORT_TITLE, _
            "Nicht unterstuetzte Schema-Version: " & FieldValue(ids, values, "schema_version")
    End If
    If Not IsAllowedValue(FieldValue(ids, values, "document_status"), _
        Array("confirmed_draft", "confirmed_final")) Then
        Err.Raise vbObjectError + 111, IMPORT_TITLE, _
            "Der Dokumentstatus ist nicht als bestaetigter Entwurf oder bestaetigte Endfassung gekennzeichnet."
    End If
    If Not IsAllowedValue(LCase$(FieldValue(ids, values, "test_case_flag")), Array("true", "false")) Then
        Err.Raise vbObjectError + 112, IMPORT_TITLE, "test_case_flag muss true oder false sein."
    End If

    RequireText ids, values, "idea_title"
    RequireText ids, values, "short_description"
    RequireText ids, values, "process_label_user"
    RequireText ids, values, "current_workflow"
    RequireText ids, values, "pain_point"
    RequireText ids, values, "target_state"
    RequireText ids, values, "qualitative_benefit"
    RequireText ids, values, "score_benefit_reason"
    RequireText ids, values, "score_effort_reason"
    RequireText ids, values, "score_urgency_reason"

    If Not TryParseIsoDate(FieldValue(ids, values, "captured_at"), annualHours) Then
        Err.Raise vbObjectError + 113, IMPORT_TITLE, "captured_at muss ein gueltiges Datum im Format JJJJ-MM-TT sein."
    End If
    If Len(FieldValue(ids, values, "latest_effective_date")) > 0 Then
        If Not TryParseIsoDate(FieldValue(ids, values, "latest_effective_date"), annualHours) Then
            Err.Raise vbObjectError + 114, IMPORT_TITLE, _
                "latest_effective_date ist kein gueltiges Datum im Format JJJJ-MM-TT."
        End If
    End If

    numericIds = Array("cases_per_year", "current_minutes_per_case", "saving_minutes_per_case", _
        "annual_time_saving_hours", "one_time_case_count", "one_time_saving_minutes_per_case", _
        "one_time_time_saving_hours", "affected_employees", "one_time_financial_benefit_eur", _
        "recurring_financial_benefit_eur_year", "implementation_duration_value", _
        "internal_effort_value", "external_one_time_cost_eur", "annual_operating_license_cost_eur")

    For Each item In numericIds
        indexValue = FindIdentifierIndex(ids, CStr(item))
        If Len(values(indexValue)) > 0 Then
            If Not TryParseNonNegativeNumber(values(indexValue), scoreValue) Then
                Err.Raise vbObjectError + 115, IMPORT_TITLE, _
                    CStr(item) & " muss leer oder eine nichtnegative Zahl sein."
            End If
        End If
    Next item

    ValidateScore ids, values, "score_benefit"
    ValidateScore ids, values, "score_effort"
    ValidateScore ids, values, "score_urgency"

    If TryParseNonNegativeNumber(FieldValue(ids, values, "current_minutes_per_case"), currentMinutes) And _
       TryParseNonNegativeNumber(FieldValue(ids, values, "saving_minutes_per_case"), savingValue) Then
        If savingValue > currentMinutes Then
            Err.Raise vbObjectError + 116, IMPORT_TITLE, _
                "Die erwartete Zeitersparnis je Vorgang ist groesser als der heutige Zeitaufwand."
        End If
    End If

    If TryParseNonNegativeNumber(FieldValue(ids, values, "cases_per_year"), casesValue) And _
       TryParseNonNegativeNumber(FieldValue(ids, values, "saving_minutes_per_case"), savingValue) And _
       TryParseNonNegativeNumber(FieldValue(ids, values, "annual_time_saving_hours"), annualHours) Then
        If Abs(annualHours - (casesValue * savingValue / 60#)) > 0.02 Then
            Err.Raise vbObjectError + 117, IMPORT_TITLE, _
                "Die jaehrliche Zeitersparnis widerspricht Vorgangsmenge und Einsparung je Vorgang."
        End If
    End If

    ValidatePairedUnit ids, values, "implementation_duration_value", "implementation_duration_unit", _
        Array("weeks", "months", "wochen", "monate")
    ValidatePairedUnit ids, values, "internal_effort_value", "internal_effort_unit", _
        Array("person_days", "fte_months", "personentage", "fte-monate")
End Sub

Private Sub ValidateEstimateData(ByRef coreIds() As String, ByRef coreValues() As String, _
    ByRef estimateIds() As String, ByRef statusValues() As String, ByRef sourceValues() As String, _
    ByRef confidenceValues() As String, ByRef verifyByValues() As String)

    Dim expected As Variant, i As Long, coreValue As String

    expected = ExpectedEstimateIds()
    ValidateExactIdentifierSet estimateIds, expected, "Schaetzungstabelle"

    For i = LBound(estimateIds) To UBound(estimateIds)
        coreValue = FieldValue(coreIds, coreValues, estimateIds(i))
        If Len(statusValues(i)) = 0 Then
            Err.Raise vbObjectError + 120, IMPORT_TITLE, _
                "In der Schaetzungstabelle fehlt der Status fuer " & estimateIds(i) & "."
        End If
        If Not IsAllowedValue(confidenceValues(i), Array("open", "low", "medium", "high")) Then
            Err.Raise vbObjectError + 121, IMPORT_TITLE, _
                "Ungueltige Sicherheit fuer " & estimateIds(i) & ": " & confidenceValues(i)
        End If
        If Len(coreValue) > 0 And LCase$(coreValue) <> "open" Then
            If statusValues(i) = "open" Or sourceValues(i) = "open" Or confidenceValues(i) = "open" Then
                Err.Raise vbObjectError + 122, IMPORT_TITLE, _
                    "Der Wert " & estimateIds(i) & " ist befuellt, aber sein Schaetzungsnachweis ist offen."
            End If
        End If
        If Len(verifyByValues(i)) = 0 Then
            Err.Raise vbObjectError + 123, IMPORT_TITLE, _
                "In der Schaetzungstabelle fehlt die spaetere Pruefrolle fuer " & estimateIds(i) & "."
        End If
    Next i
End Sub

Private Sub ValidateExactIdentifierSet(ByRef actualIds() As String, ByVal expectedIds As Variant, ByVal tableName As String)
    Dim i As Long, expectedItem As Variant, occurrenceCount As Long

    If UBound(actualIds) - LBound(actualIds) + 1 <> UBound(expectedIds) - LBound(expectedIds) + 1 Then
        Err.Raise vbObjectError + 125, IMPORT_TITLE, tableName & " hat eine unerwartete Anzahl von Kennungen."
    End If

    For Each expectedItem In expectedIds
        occurrenceCount = 0
        For i = LBound(actualIds) To UBound(actualIds)
            If actualIds(i) = CStr(expectedItem) Then occurrenceCount = occurrenceCount + 1
        Next i
        If occurrenceCount <> 1 Then
            Err.Raise vbObjectError + 126, IMPORT_TITLE, _
                tableName & ": Kennung '" & CStr(expectedItem) & "' fehlt oder ist doppelt."
        End If
    Next expectedItem

    For i = LBound(actualIds) To UBound(actualIds)
        If Not ArrayContains(expectedIds, actualIds(i)) Then
            Err.Raise vbObjectError + 127, IMPORT_TITLE, _
                tableName & ": unbekannte Kennung '" & actualIds(i) & "'."
        End If
    Next i
End Sub

Private Function ExpectedCoreIds() As Variant
    Dim idList As String
    idList = "schema_version|document_status|test_case_flag|captured_at|idea_title|short_description|process_label_user|process_classification_internal|process_classification_source|current_workflow|pain_point|pain_frequency|pain_impact|department|business_owner|business_owner_status|target_state|human_review_required|current_systems|current_data|current_data_availability_quality|known_prework|desired_operating_mode"
    idList = idList & "|qualitative_benefit|benefit_type|cases_per_year|current_minutes_per_case|saving_minutes_per_case|annual_time_saving_hours|annual_time_saving_calculation|one_time_case_count|one_time_saving_minutes_per_case|one_time_time_saving_hours|one_time_time_saving_calculation|affected_employees|affected_roles|one_time_financial_benefit_eur|recurring_financial_benefit_eur_year|financial_benefit_derivation"
    idList = idList & "|latest_effective_date|latest_effective_timing_text|deadline_type|delay_consequence_6_months|obligation_dependency|quality_notes|data_protection_notes|information_security_notes|risk_notes|compliance_notes|strategic_contribution|implementation_duration_value|implementation_duration_unit|internal_effort_value|internal_effort_unit|external_one_time_cost_eur|annual_operating_license_cost_eur"
    idList = idList & "|score_benefit|score_benefit_reason|score_effort|score_effort_reason|score_urgency|score_urgency_reason|triage_path|triage_reason|internal_sources_used|similarity_check_result|open_questions|team_na_supplements"
    ExpectedCoreIds = Split(idList, "|")
End Function

Private Function ExpectedEstimateIds() As Variant
    ExpectedEstimateIds = Split( _
        "cases_per_year|current_minutes_per_case|saving_minutes_per_case|annual_time_saving_hours|" & _
        "one_time_case_count|one_time_saving_minutes_per_case|one_time_time_saving_hours|" & _
        "affected_employees|one_time_financial_benefit_eur|recurring_financial_benefit_eur_year|" & _
        "implementation_duration_value|internal_effort_value|external_one_time_cost_eur|" & _
        "annual_operating_license_cost_eur|score_benefit|score_effort|score_urgency", "|")
End Function

Private Sub RequireText(ByRef ids() As String, ByRef values() As String, ByVal fieldId As String)
    If Len(Trim$(FieldValue(ids, values, fieldId))) = 0 Then
        Err.Raise vbObjectError + 130, IMPORT_TITLE, "Pflichtangabe fehlt: " & fieldId
    End If
End Sub

Private Sub ValidateScore(ByRef ids() As String, ByRef values() As String, ByVal fieldId As String)
    Dim scoreValue As Double
    If Not TryParseNonNegativeNumber(FieldValue(ids, values, fieldId), scoreValue) Then
        Err.Raise vbObjectError + 131, IMPORT_TITLE, fieldId & " muss eine Zahl von 1 bis 5 sein."
    End If
    If scoreValue < 1 Or scoreValue > 5 Or scoreValue <> Fix(scoreValue) Then
        Err.Raise vbObjectError + 132, IMPORT_TITLE, fieldId & " muss eine ganze Zahl von 1 bis 5 sein."
    End If
End Sub

Private Sub ValidatePairedUnit(ByRef ids() As String, ByRef values() As String, _
    ByVal valueId As String, ByVal unitId As String, ByVal allowedUnits As Variant)

    Dim numberValue As Double, unitValue As String
    unitValue = LCase$(FieldValue(ids, values, unitId))
    If TryParseNonNegativeNumber(FieldValue(ids, values, valueId), numberValue) Then
        If Not IsAllowedValue(unitValue, allowedUnits) Then
            Err.Raise vbObjectError + 133, IMPORT_TITLE, _
                "Zu " & valueId & " fehlt eine gueltige Einheit."
        End If
    ElseIf Len(FieldValue(ids, values, valueId)) = 0 Then
        If Len(unitValue) > 0 And unitValue <> "open" Then
            Err.Raise vbObjectError + 134, IMPORT_TITLE, _
                "Zu " & unitId & " fehlt der Zahlenwert."
        End If
    End If
End Sub

Private Function FindBacklogTable(ByVal ws As Worksheet) As ListObject
    Dim tableItem As ListObject

    On Error Resume Next
    Set FindBacklogTable = ws.ListObjects(PREFERRED_TABLE)
    On Error GoTo 0
    If Not FindBacklogTable Is Nothing Then Exit Function

    For Each tableItem In ws.ListObjects
        If FindHeaderIndex(tableItem, "Projekt") > 0 And FindHeaderIndex(tableItem, "Kundennutzen") > 0 Then
            Set FindBacklogTable = tableItem
            Exit Function
        End If
    Next tableItem
    Err.Raise vbObjectError + 140, IMPORT_TITLE, "Die Backlog-Tabelle wurde nicht gefunden."
End Function

Private Sub ValidateWorkbookStructure(ByVal backlog As ListObject)
    Dim requiredHeaders As Variant, headerItem As Variant

    requiredHeaders = Array("Projekt", "Teilprozess", "Fachbereich", _
        "Kurzbeschreibung der Projektidee", "Beschreibung des Schmerzpunktes", _
        "Gewuenschter Ausgang / Zielbild", "Dringlichkeit (Qualitativ)", _
        "NEU | Spaetester Wirksamkeitstermin", "NEU | Folge bei 6 Monaten Verzoegerung", _
        "NEU | Verpflichtung oder Abhaengigkeit", "NEU | Dringlichkeit (1-5)", _
        "NEU | Begruendung Dringlichkeit", "Erwarteter Nutzen", "Nutzen umrechnung", _
        "NEU | Erklaerung zum numerischen Nutzen", "NEU | Gesamtvorgaenge pro Jahr", _
        "NEU | Heutiger Zeitaufwand je Vorgang (Min.)", "NEU | Einsparung je Vorgang (Min.)", _
        "NEU | Betroffene Mitarbeitende (optional)", "NEU | Betroffene Rollen (optional)", _
        "NEU | Einmaliger finanzieller Nutzen (EUR)", "NEU | Wiederkehrender finanzieller Nutzen (EUR/Jahr)", _
        "Verfuegbarkeit von Daten (optional)", "Welche IT-Systeme sind betroffen (optional)", _
        "NEU | Datenverfuegbarkeit und -qualitaet", "NEU | Datenschutz/Sicherheit/Regulierung", _
        "Anmerkungen", "Quelle", "NEU | Sicherheit der Schaetzung", _
        "NEU | Bewertungsstatus und Quelle", "Kundennutzen", "Aufwand", "Dringlichkeit", _
        "NEU | Umsetzungsdauer", "NEU | Einheit Umsetzungsdauer", _
        "NEU | Interner Aufwand", "NEU | Einheit interner Aufwand", _
        "NEU | Erwartete externe Einmalkosten (EUR)", "NEU | Betriebs- und Lizenzkosten (EUR/Jahr)", _
        "NEU | Gesamtprioritaets-Score", "NEU | Quick-Win-Score")

    For Each headerItem In requiredHeaders
        If FindHeaderIndex(backlog, CStr(headerItem)) = 0 Then
            Err.Raise vbObjectError + 141, IMPORT_TITLE, _
                "Erwartete Backlog-Ueberschrift fehlt: " & CStr(headerItem)
        End If
    Next headerItem
End Sub

Private Function FindOrCreateEmptyRow(ByVal backlog As ListObject, ByRef rowWasAdded As Boolean) As ListRow
    Dim projectIndex As Long, rowIndex As Long

    projectIndex = FindHeaderIndex(backlog, "Projekt")
    If Not backlog.DataBodyRange Is Nothing Then
        For rowIndex = 1 To backlog.ListRows.Count
            If Len(Trim$(CStr(backlog.DataBodyRange.Cells(rowIndex, projectIndex).Value2))) = 0 Then
                Set FindOrCreateEmptyRow = backlog.ListRows(rowIndex)
                Exit Function
            End If
        Next rowIndex
    End If

    rowWasAdded = True
    Set FindOrCreateEmptyRow = backlog.ListRows.Add
End Function

Private Function ProjectAlreadyExists(ByVal backlog As ListObject, ByVal ideaTitle As String) As Boolean
    Dim projectIndex As Long, rowIndex As Long, existingTitle As String

    If backlog.DataBodyRange Is Nothing Then Exit Function
    projectIndex = FindHeaderIndex(backlog, "Projekt")
    For rowIndex = 1 To backlog.ListRows.Count
        existingTitle = Trim$(CStr(backlog.DataBodyRange.Cells(rowIndex, projectIndex).Value2))
        If StrComp(existingTitle, ideaTitle, vbTextCompare) = 0 Then
            ProjectAlreadyExists = True
            Exit Function
        End If
    Next rowIndex
End Function

