Private Function FindHeaderIndex(ByVal backlog As ListObject, ByVal requestedHeader As String) As Long
    Dim columnIndex As Long
    For columnIndex = 1 To backlog.ListColumns.Count
        If NormalizeHeader(backlog.ListColumns(columnIndex).Name) = NormalizeHeader(requestedHeader) Then
            FindHeaderIndex = columnIndex
            Exit Function
        End If
    Next columnIndex
End Function

Private Function NormalizeHeader(ByVal textValue As String) As String
    textValue = LCase$(Trim$(textValue))
    ' Keine Umlaute als Quelltext-Literale verwenden: Der VBA-Editor auf dem Mac
    ' importiert .bas-Dateien nicht immer mit derselben Zeichenkodierung.
    textValue = Replace(textValue, ChrW$(&HE4), "ae")
    textValue = Replace(textValue, ChrW$(&HC4), "ae")
    textValue = Replace(textValue, ChrW$(&HF6), "oe")
    textValue = Replace(textValue, ChrW$(&HD6), "oe")
    textValue = Replace(textValue, ChrW$(&HFC), "ue")
    textValue = Replace(textValue, ChrW$(&HDC), "ue")
    textValue = Replace(textValue, ChrW$(&HDF), "ss")
    textValue = Replace(textValue, ChrW$(&H20AC), "eur")
    textValue = Replace(textValue, ChrW$(160), " ")
    textValue = Replace(textValue, vbTab, " ")
    textValue = Replace(textValue, vbCr, " ")
    textValue = Replace(textValue, ChrW$(8211), "-")
    textValue = Replace(textValue, ChrW$(8212), "-")
    textValue = Replace(textValue, ChrW$(8208), "-")
    textValue = Replace(textValue, ChrW$(8209), "-")
    textValue = Replace(textValue, ChrW$(8722), "-")
    textValue = Replace(textValue, vbLf, " ")
    Do While InStr(textValue, "  ") > 0
        textValue = Replace(textValue, "  ", " ")
    Loop
    NormalizeHeader = textValue
End Function

Private Function CellByHeader(ByVal backlog As ListObject, ByVal rowIndex As Long, ByVal headerName As String) As Range
    Dim columnIndex As Long
    columnIndex = FindHeaderIndex(backlog, headerName)
    If columnIndex = 0 Then
        Err.Raise vbObjectError + 150, IMPORT_TITLE, "Backlog-Ueberschrift nicht gefunden: " & headerName
    End If
    Set CellByHeader = backlog.DataBodyRange.Cells(rowIndex, columnIndex)
End Function

Private Sub SetText(ByVal backlog As ListObject, ByVal rowIndex As Long, ByVal headerName As String, ByVal textValue As String)
    If IsOpenValue(textValue) Then Exit Sub
    CellByHeader(backlog, rowIndex, headerName).Value2 = textValue
End Sub

Private Sub SetTypedValue(ByVal backlog As ListObject, ByVal rowIndex As Long, ByVal headerName As String, ByVal typedValue As Variant)
    CellByHeader(backlog, rowIndex, headerName).Value = typedValue
End Sub

Private Sub SetNumber(ByVal backlog As ListObject, ByVal rowIndex As Long, ByVal headerName As String, ByVal rawValue As String)
    Dim numberValue As Double
    If Not TryParseNonNegativeNumber(rawValue, numberValue) Then
        Err.Raise vbObjectError + 151, IMPORT_TITLE, "Ungueltige Zahl fuer " & headerName
    End If
    CellByHeader(backlog, rowIndex, headerName).Value2 = numberValue
End Sub

Private Sub SetOptionalNumber(ByVal backlog As ListObject, ByVal rowIndex As Long, ByVal headerName As String, _
    ByRef ids() As String, ByRef values() As String, ByVal fieldId As String)

    Dim rawValue As String, numberValue As Double
    rawValue = FieldValue(ids, values, fieldId)
    If Len(rawValue) = 0 Or IsOpenValue(rawValue) Then Exit Sub
    If Not TryParseNonNegativeNumber(rawValue, numberValue) Then
        Err.Raise vbObjectError + 152, IMPORT_TITLE, "Ungueltige Zahl fuer " & fieldId
    End If
    CellByHeader(backlog, rowIndex, headerName).Value2 = numberValue
End Sub

Private Function FieldValue(ByRef ids() As String, ByRef values() As String, ByVal fieldId As String) As String
    Dim foundIndex As Long
    foundIndex = FindIdentifierIndex(ids, LCase$(fieldId))
    If foundIndex = 0 Then
        Err.Raise vbObjectError + 160, IMPORT_TITLE, "Feldkennung fehlt: " & fieldId
    End If
    FieldValue = values(foundIndex)
End Function

Private Function FindIdentifierIndex(ByRef ids() As String, ByVal requestedId As String) As Long
    Dim i As Long
    For i = LBound(ids) To UBound(ids)
        If StrComp(ids(i), requestedId, vbTextCompare) = 0 Then
            FindIdentifierIndex = i
            Exit Function
        End If
    Next i
End Function

Private Function TryParseNonNegativeNumber(ByVal rawValue As String, ByRef parsedValue As Double) As Boolean
    Dim normalized As String, i As Long, characterValue As String, dotCount As Long

    normalized = Trim$(rawValue)
    If Len(normalized) = 0 Or LCase$(normalized) = "open" Then Exit Function
    normalized = Replace(normalized, " ", "")
    normalized = Replace(normalized, ",", ".")

    For i = 1 To Len(normalized)
        characterValue = Mid$(normalized, i, 1)
        If characterValue = "." Then
            dotCount = dotCount + 1
            If dotCount > 1 Then Exit Function
        ElseIf characterValue < "0" Or characterValue > "9" Then
            Exit Function
        End If
    Next i

    If normalized = "." Then Exit Function
    parsedValue = Val(normalized)
    If parsedValue < 0 Then Exit Function
    TryParseNonNegativeNumber = True
End Function

Private Function TryParseIsoDate(ByVal rawValue As String, ByRef serialValue As Double) As Boolean
    Dim parts As Variant, yearValue As Long, monthValue As Long, dayValue As Long
    Dim parsedDate As Date

    If Len(rawValue) <> 10 Then Exit Function
    parts = Split(rawValue, "-")
    If UBound(parts) <> 2 Then Exit Function
    If Not IsNumeric(parts(0)) Or Not IsNumeric(parts(1)) Or Not IsNumeric(parts(2)) Then Exit Function

    yearValue = CLng(parts(0))
    monthValue = CLng(parts(1))
    dayValue = CLng(parts(2))
    On Error GoTo InvalidDate
    parsedDate = DateSerial(yearValue, monthValue, dayValue)
    If Year(parsedDate) <> yearValue Or Month(parsedDate) <> monthValue Or Day(parsedDate) <> dayValue Then GoTo InvalidDate
    serialValue = CDbl(parsedDate)
    TryParseIsoDate = True
    Exit Function
InvalidDate:
    TryParseIsoDate = False
End Function

Private Function IsAllowedValue(ByVal actualValue As String, ByVal allowedValues As Variant) As Boolean
    IsAllowedValue = ArrayContains(allowedValues, LCase$(Trim$(actualValue)))
End Function

Private Function ArrayContains(ByVal valuesArray As Variant, ByVal searchedValue As String) As Boolean
    Dim item As Variant
    For Each item In valuesArray
        If StrComp(CStr(item), searchedValue, vbTextCompare) = 0 Then
            ArrayContains = True
            Exit Function
        End If
    Next item
End Function

Private Function IsOpenValue(ByVal rawValue As String) As Boolean
    Dim normalized As String
    normalized = LCase$(Trim$(rawValue))
    IsOpenValue = (Len(normalized) = 0 Or normalized = "open" Or normalized = "offen" Or _
                   normalized = "nicht bekannt" Or normalized = "unbekannt")
End Function

Private Function JoinLabelled(ByVal labels As Variant, ByVal values As Variant) As String
    Dim i As Long, resultText As String, currentValue As String
    For i = LBound(labels) To UBound(labels)
        currentValue = Trim$(CStr(values(i)))
        If Len(currentValue) > 0 Then
            If Len(resultText) > 0 Then resultText = resultText & vbLf
            resultText = resultText & CStr(labels(i)) & ": " & currentValue
        End If
    Next i
    JoinLabelled = resultText
End Function

Private Function ValueWithUnit(ByVal rawValue As String, ByVal unitText As String) As String
    If IsOpenValue(rawValue) Then Exit Function
    ValueWithUnit = rawValue & " " & unitText
End Function

Private Function FinancialBenefitSummary(ByRef ids() As String, ByRef values() As String) As String
    Dim resultText As String, oneTimeValue As String, recurringValue As String
    oneTimeValue = FieldValue(ids, values, "one_time_financial_benefit_eur")
    recurringValue = FieldValue(ids, values, "recurring_financial_benefit_eur_year")
    If Not IsOpenValue(oneTimeValue) Then resultText = "einmalig " & oneTimeValue & " EUR"
    If Not IsOpenValue(recurringValue) Then
        If Len(resultText) > 0 Then resultText = resultText & "; "
        resultText = resultText & recurringValue & " EUR/Jahr"
    End If
    FinancialBenefitSummary = resultText
End Function

Private Function MapObligation(ByVal rawValue As String) As String
    Dim valueLower As String
    valueLower = NormalizeHeader(rawValue)
    If InStr(valueLower, "keine") > 0 Then
        MapObligation = "Keine feste Abh" & ChrW$(&HE4) & "ngigkeit"
    ElseIf InStr(valueLower, "gesetz") > 0 Or InStr(valueLower, "regulator") > 0 Then
        MapObligation = "Gesetzlich/regulatorisch"
    ElseIf InStr(valueLower, "betrieb") > 0 Then
        MapObligation = "Betriebliche Notwendigkeit"
    ElseIf InStr(valueLower, "projekt") > 0 And InStr(valueLower, "block") > 0 Then
        MapObligation = "Anderes Projekt blockiert"
    Else
        MapObligation = "Unbekannt"
    End If
End Function

Private Function MapDataQuality(ByVal rawValue As String) As String
    Dim valueLower As String
    valueLower = NormalizeHeader(rawValue)
    If IsOpenValue(rawValue) Then
        MapDataQuality = "Nicht bekannt"
    ElseIf InStr(valueLower, "schlecht") > 0 Then
        MapDataQuality = "Schlecht"
    ElseIf InStr(valueLower, "teilweise") > 0 Or InStr(valueLower, "uneinheit") > 0 Or _
           InStr(valueLower, "unvollstaendig") > 0 Then
        MapDataQuality = "Teilweise"
    ElseIf InStr(valueLower, "gut") > 0 Then
        MapDataQuality = "Gut"
    ElseIf InStr(valueLower, "verfuegbar") > 0 Or _
           InStr(valueLower, "zugaenglich") > 0 Then
        MapDataQuality = "Verf" & ChrW$(&HFC) & "gbar"
    Else
        MapDataQuality = "Nicht bekannt"
    End If
End Function

Private Function MapProtectionReview(ByVal privacyText As String, ByVal securityText As String, ByVal complianceText As String) As String
    Dim combinedText As String
    combinedText = NormalizeHeader(privacyText & " " & securityText & " " & complianceText)
    If InStr(combinedText, "offen") > 0 Or InStr(combinedText, "nicht durchgefuehrt") > 0 Or _
       InStr(combinedText, "ungeklaert") > 0 Then
        MapProtectionReview = "Ungekl" & ChrW$(&HE4) & "rt"
    ElseIf InStr(combinedText, "erhoeht") > 0 Then
        MapProtectionReview = "Erh" & ChrW$(&HF6) & "hter Pr" & ChrW$(&HFC) & "fbedarf"
    ElseIf InStr(combinedText, "kein pruefbedarf") > 0 Then
        MapProtectionReview = "Kein Pr" & ChrW$(&HFC) & "fbedarf"
    Else
        MapProtectionReview = "Normaler Pr" & ChrW$(&HFC) & "fbedarf"
    End If
End Function

Private Function MapDurationUnit(ByVal rawValue As String) As String
    Select Case LCase$(rawValue)
        Case "weeks", "wochen": MapDurationUnit = "Wochen"
        Case "months", "monate": MapDurationUnit = "Monate"
    End Select
End Function

Private Function MapEffortUnit(ByVal rawValue As String) As String
    Select Case LCase$(rawValue)
        Case "person_days", "personentage": MapEffortUnit = "Personentage"
        Case "fte_months", "fte-monate": MapEffortUnit = "FTE-Monate"
    End Select
End Function

Private Function OverallConfidence(ByRef coreIds() As String, ByRef coreValues() As String, _
    ByRef estimateIds() As String, ByRef confidenceValues() As String) As String

    Dim i As Long, rankValue As Long, lowestRank As Long, coreValue As String
    lowestRank = 4
    For i = LBound(estimateIds) To UBound(estimateIds)
        coreValue = FieldValue(coreIds, coreValues, estimateIds(i))
        If Not IsOpenValue(coreValue) Then
            Select Case LCase$(confidenceValues(i))
                Case "low": rankValue = 1
                Case "medium": rankValue = 2
                Case "high": rankValue = 3
                Case Else: rankValue = 0
            End Select
            If rankValue > 0 And rankValue < lowestRank Then lowestRank = rankValue
        End If
    Next i

    Select Case lowestRank
        Case 1: OverallConfidence = "Niedrig"
        Case 2: OverallConfidence = "Mittel"
        Case 3: OverallConfidence = "Hoch"
        Case Else: OverallConfidence = "Niedrig"
    End Select
End Function

Private Function BuildEstimateEvidence(ByRef ids() As String, ByRef statusValues() As String, _
    ByRef sourceValues() As String, ByRef confidenceValues() As String, ByRef verifyByValues() As String) As String

    Dim i As Long, resultText As String
    For i = LBound(ids) To UBound(ids)
        If Len(resultText) > 0 Then resultText = resultText & vbLf
        resultText = resultText & ids(i) & ": Status=" & statusValues(i) & _
            "; Quelle=" & sourceValues(i) & "; Sicherheit=" & confidenceValues(i) & _
            "; Pruefung=" & verifyByValues(i)
    Next i
    BuildEstimateEvidence = resultText
End Function

Private Function FileNameFromPath(ByVal fullPath As String) As String
    Dim slashPosition As Long, backslashPosition As Long, lastSeparator As Long
    slashPosition = InStrRev(fullPath, "/")
    backslashPosition = InStrRev(fullPath, "\")
    If slashPosition > backslashPosition Then lastSeparator = slashPosition Else lastSeparator = backslashPosition
    If lastSeparator > 0 Then
        FileNameFromPath = Mid$(fullPath, lastSeparator + 1)
    Else
        FileNameFromPath = fullPath
    End If
End Function
